# Copy to `.env` for local Docker Compose, or set the same keys as stack
# environment variables in Portainer. Never commit the filled-in `.env`.
#
# Only DOWNLOADER_BOT_TOKEN is required. Everything else is commented out and
# shows the value the bot falls back to, so uncomment a line only to change it.
# Defaults live in `downloader/config.py`; both compose files repeat them.


# --------------------------------------------------------------------------- #
# Required
# --------------------------------------------------------------------------- #

# Token from @BotFather.
DOWNLOADER_BOT_TOKEN=


# --------------------------------------------------------------------------- #
# Access control
# --------------------------------------------------------------------------- #

# Comma-separated chat ids the bot may answer in. Group ids are negative, e.g.
# "-1001234567890,-1009876543210". Empty means the bot answers EVERYWHERE — set
# this before adding the bot to any public group. To find an id, send a message
# in the chat and read it from the log line: "[Title (id=-100…)] … requested".
#ALLOWED_CHAT_IDS=


# --------------------------------------------------------------------------- #
# Limits
# --------------------------------------------------------------------------- #

# Telegram bot API caps uploads at 50 MB; a larger value only makes the bot
# download files it cannot send.
#MAX_FILE_SIZE_MB=50

# Longest "short" video accepted, in seconds. Checked when the link arrives.
#MAX_SHORT_DURATION_SEC=300

# Hard ceiling re-checked after downloading, in seconds. Catches videos whose
# real length differs from the metadata.
#MAX_DURATION_SEC=600


# --------------------------------------------------------------------------- #
# Cookies
# --------------------------------------------------------------------------- #

# Paths as seen INSIDE the container. Both compose files mount the host cookie
# directory at /app/cookies. Running the bot outside Docker? Point these at
# downloader/cookies/… instead. Netscape cookies.txt format.
# Unset means "no cookies", which is fine until a site starts asking.

# Used for TikTok.
#COOKIES_FILE=/app/cookies/cookies.txt

# Only if YouTube starts demanding a login. Must be a separate file.
#YOUTUBE_COOKIES_FILE=/app/cookies/youtubecookies.txt

# Portainer stack only (not read by the bot): host directory mounted at
# /app/cookies. Create it before deploying, or Docker makes it root-owned.
#COOKIES_HOST_DIR=/opt/sbahelper/cookies


# --------------------------------------------------------------------------- #
# Weekly statistics
# --------------------------------------------------------------------------- #

# Set to 0 to switch off the download log, /stats, and the weekly message.
#STATS_ENABLED=1

# When the weekly summary is posted. Weekday follows datetime.weekday():
# 0 = Monday … 6 = Sunday. Note that downloads made after the send time fall
# outside both that report and the next one, which starts Monday 00:00.
#STATS_WEEKLY_WEEKDAY=6
#STATS_WEEKLY_TIME=20:00
#STATS_TIMEZONE=Europe/Tallinn

# How long individual download rows are kept, in days. Pruned after each weekly
# run. 0 keeps everything forever.
#STATS_RETENTION_DAYS=400

# SQLite file inside the container. /data is a mounted volume in both compose
# files — putting this outside /data means losing stats on every redeploy.
#STATS_DB_PATH=/data/downloader_stats.db


# --------------------------------------------------------------------------- #
# Startup checks
# --------------------------------------------------------------------------- #

# Smoke checks: real short vertical video links the bot downloads before it
# starts polling, to catch a broken yt-dlp, expired cookies or a missing ffmpeg
# at deploy time rather than on the first user request. Unset checks are
# skipped, so leaving these empty disables startup checking entirely.
# Pick stable videos — a deleted or geo-blocked link fails every restart.
#CHECK_YOUTUBE_URL=https://youtube.com/shorts/…
#CHECK_TIKTOK_URL=https://www.tiktok.com/@user/video/…

# 1 = the check downloads the video in full (format selection, yt-dlp, ffmpeg
# merge, size and audio verification), then deletes it. Adds ~10-20s to
# startup. 0 = read metadata only, which is fast but never exercises the
# download path where breakage usually happens.
#STARTUP_CHECK_DOWNLOAD=1

# 1 = a failed check stops startup. A fixture that is simply wrong for this bot
# (photo post, too long) and flaky provider responses (e.g. a TikTok 403) are
# always warnings, never blockers.
#STARTUP_CHECKS_REQUIRED=1


# --------------------------------------------------------------------------- #
# Logging and error tracking
# --------------------------------------------------------------------------- #

# DEBUG, INFO, WARNING, ERROR. DEBUG logs every message the bot ignores.
#LOG_LEVEL=INFO

# Sentry is off unless a DSN is set. Transient network errors are filtered out.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_RELEASE=


# --------------------------------------------------------------------------- #
# Paths
# --------------------------------------------------------------------------- #

# Scratch directory for downloads in progress. Files are deleted right after
# they are sent; only change this if /tmp is small or read-only.
#DOWNLOAD_DIR=/tmp/downloader_videos
