# Copy to .env for local runs (docker compose, or `uv run --env-file .env -m sbahelper`),
# or set the same keys as Portainer stack variables. Only the token is required;
# the commented values are the defaults from sbahelper/config.py.

# Token from @BotFather.
DOWNLOADER_BOT_TOKEN=

# Comma-separated chat ids the bot answers in (groups are negative, e.g. -1001234567890).
# Empty = every chat. The id of a chat is in the "Link received. Chat=…" log line.
#ALLOWED_CHAT_IDS=

# Comma-separated Telegram user ids of admins. They get error alerts in DM, can send
# the bot cookie files, and use /cookies and /check. Each admin must press Start once.
#ADMIN_IDS=

# Timezone for logs and the weekly summary.
#TZ=Europe/Tallinn

# DEBUG, INFO, WARNING, ERROR.
#LOG_LEVEL=INFO

# Telegram bots cannot upload more than 50 MB.
#MAX_FILE_SIZE_MB=50
#MAX_SHORT_DURATION_SEC=300

# Cookie files live here (tiktok.txt, youtube.txt). Outside Docker, point it somewhere local.
#COOKIES_DIR=/data/cookies

# Known-good short vertical videos, downloaded 5 s after startup and on /check.
# Failures are sent to admins. Empty = skipped.
#CHECK_TIKTOK_URL=https://www.tiktok.com/@user/video/…
#CHECK_YOUTUBE_URL=https://www.youtube.com/shorts/…

# Weekly summary per chat. Weekday: 0 = Monday … 6 = Sunday.
#STATS_ENABLED=1
#STATS_WEEKLY_WEEKDAY=6
#STATS_WEEKLY_TIME=20:00
# Days of rows to keep, pruned after each weekly run. 0 = forever.
#STATS_RETENTION_DAYS=400
#STATS_DB_PATH=/data/downloader_stats.db
