# Copy this file to `.env` for local Docker Compose, or set these keys as
# Portainer/stack environment variables.

# Required - bot token
DOWNLOADER_BOT_TOKEN=

# Limits
MAX_FILE_SIZE_MB=50
MAX_SHORT_DURATION_SEC=300

# Weekly statistics (0 = Monday ... 6 = Sunday)
STATS_WEEKLY_WEEKDAY=6
STATS_WEEKLY_TIME=20:00
STATS_TIMEZONE=Europe/Tallinn

# Optional
ALLOWED_CHAT_IDS=
COOKIES_FILE=/app/cookies/cookies.txt
YOUTUBE_COOKIES_FILE=
SENTRY_DSN=
