# Copy this file to `.env` for local Docker Compose, or set these keys as
# Portainer/stack environment variables.

# Required - bot tokens
DOWNLOADER_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# uMap maps to watch (bike + walk)
UMAP_BIKE_MAP_ID=1393155
UMAP_BIKE_LAYER_ID=82e959ea-1b66-4088-b7f3-8fe6a06c3c4a
UMAP_BIKE_PLANS_LAYER_ID=e62ab6f9-0c21-4521-93c5-df47a4857fda
UMAP_WALK_MAP_ID=1415270

# Limits and intervals
MAX_FILE_SIZE_MB=50
MAX_SHORT_DURATION_SEC=300
POLL_INTERVAL_SECONDS=300
CHANGE_POLL_INTERVAL_SECONDS=3600

# Optional
ALLOWED_CHAT_IDS=
DEFAULT_SUBSCRIBER_CHAT_ID=
COOKIES_FILE=/app/cookies/cookies.txt
YOUTUBE_COOKIES_FILE=
SENTRY_DSN=
