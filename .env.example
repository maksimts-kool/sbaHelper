# Copy to .env for local runs (docker compose, or `uv run --env-file .env -m sbahelper`),
# or set the same keys as Portainer stack variables. Only the token is required;
# the commented values are the defaults from sbahelper/config.py. An invalid value
# falls back to its default and is reported as a warning at startup.

# Token from @BotFather.
DOWNLOADER_BOT_TOKEN=

# --- Access ----------------------------------------------------------------
# open      = answer in every chat
# allowlist = only chats in ALLOWED_CHAT_IDS (plus admins' private chats)
# Unset: allowlist when ALLOWED_CHAT_IDS is set, otherwise open (the old behaviour).
# An unknown value, or an ALLOWED_CHAT_IDS with invalid entries, fails closed.
#ACCESS_POLICY=
# Comma-separated chat ids (groups are negative, e.g. -1001234567890).
# The id of a chat is in the "Link received. Chat=…" log line.
#ALLOWED_CHAT_IDS=

# Telegram user ids of bot admins: error alerts in DM, cookie uploads, /status,
# /cookies, /check. Each admin must press Start once. Not group admins.
#ADMIN_IDS=

# --- General ---------------------------------------------------------------
# Timezone for logs, statistics periods and the weekly summary.
#TZ=Europe/Tallinn
# DEBUG, INFO, WARNING, ERROR.
#LOG_LEVEL=INFO

# --- Limits ----------------------------------------------------------------
# Largest video the bot sends, in bytes (decimal: 45000000 = 45 MB). The cloud
# Bot API documents 50 MB for uploads, so values above 50000000 are refused.
#MAX_FILE_SIZE_BYTES=45000000
# Deprecated: MAX_FILE_SIZE_MB is still read (as N x 1,000,000 bytes) when
# MAX_FILE_SIZE_BYTES is unset.
#MAX_SHORT_DURATION_SEC=300
# Links taken from one message (1-10).
#MAX_LINKS_PER_MESSAGE=3
# Downloads running at once, and jobs allowed to wait in the queue.
#MAX_ACTIVE_DOWNLOADS=3
#MAX_QUEUED_DOWNLOADS=20
# Links one user / one chat may have in progress, and links per user per minute.
#MAX_PENDING_PER_USER=3
#MAX_PENDING_PER_CHAT=8
#USER_LINKS_PER_MINUTE=10
# Time budget for one download (extraction, transfer, checks).
#DOWNLOAD_TIMEOUT_SEC=240
# Work directories for downloads (needs ~3 x MAX_FILE_SIZE_BYTES per running download).
#TEMP_DIR=/tmp

# --- Telegram --------------------------------------------------------------
# Reuse Telegram file ids of already sent videos for this many days; 0 = no cache.
#CACHE_TTL_DAYS=30
# Skip updates that arrived while the bot was down (Telegram keeps them up to 24 h).
#DROP_PENDING_UPDATES=1

# --- Cookies and checks ----------------------------------------------------
# Cookie files live here (tiktok.txt, youtube.txt). Outside Docker, point it somewhere local.
#COOKIES_DIR=/data/cookies
# Known-good short vertical videos, downloaded 5 s after startup and on /check.
# Failures are sent to admins. Empty = skipped.
#CHECK_TIKTOK_URL=https://www.tiktok.com/@user/video/…
#CHECK_YOUTUBE_URL=https://www.youtube.com/shorts/…
# Every N hours the bot opens the CHECK_*_URL pages with the cookies (no download),
# so the session stays in use. It helps; it cannot guarantee a site keeps
# accepting the cookies. 0 = off.
#COOKIES_REFRESH_HOURS=4

# --- Statistics and database -------------------------------------------------
#STATS_ENABLED=1
# The SQLite database: statistics, file cache, settings.
#STATS_DB_PATH=/data/downloader_stats.db
# Weekly summary per chat. Weekday: 0 = Monday … 6 = Sunday.
#STATS_WEEKLY_WEEKDAY=6
#STATS_WEEKLY_TIME=20:00
# Days of statistics to keep, pruned daily. 0 = forever.
#STATS_RETENTION_DAYS=400

# --- Health ----------------------------------------------------------------
# Rewritten every 30 s by the running bot; `python -m sbahelper.health` checks it.
#HEARTBEAT_PATH=/tmp/sbahelper.heartbeat

# --- Docker Compose only -----------------------------------------------------
#SBAHELPER_USER=10001:10001
#SBAHELPER_TMP_SIZE=768m
#SBAHELPER_MEM_LIMIT=1536m
#SBAHELPER_CPUS=2
# Portainer stack: image tag to run (latest, or a commit SHA for pinning/rollback).
#SBAHELPER_TAG=latest
